generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("CONNECTION_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  avatar       String?
  createdAt    DateTime @default(now())
}

model Drone {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  status    String   @default("standby")
  badge     String?
  image     String?
  model     String   @default("drone_firefighter.glb")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
