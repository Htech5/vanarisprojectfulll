generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("CONNECTION_URL")
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  displayName  String
  avatar       String?
  createdAt    DateTime     @default(now())
  fireReports  FireReport[]
}

model Drone {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  status    String   @default("standby")
  badge     String?
  image     String?
  model     String   @default("drone_firefighter.glb")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FireReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  image     String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
